"""
Canonical keys for the chart payload contract.

The frontend consumes a fixed shape per data point: one X value and up to four
Y values, each with a display name. Keeping these as constants prevents the
key drift that happens when 150+ analytics functions each hand-roll their dict.
"""

XVALUE = "XVALUE"
YVALUE1 = "YVALUE1"
YVALUE2 = "YVALUE2"
YVALUE3 = "YVALUE3"
YVALUE4 = "YVALUE4"

NAME1 = "NAME1"
NAME2 = "NAME2"
NAME3 = "NAME3"
NAME4 = "NAME4"

# Dimension columns used for filtering across every module.
CLIENT_INDEX = "ClientIndex"
CITY_INDEX = "CityIndex"
LOCATION_INDEX = "LocationIndex"
DEPARTMENT_INDEX = "DepartmentIndex"
BU_INDEX = "BUIndex"
EMPLOYEE_INDEX = "EmployeeIndex"

# Status flag for an active employment record.
STATUS_ACTIVE = 1
